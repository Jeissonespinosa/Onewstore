/* ============================================================
   BUSQUEDA Y PAGINAS NATIVAS DE CATEGORIA
   ------------------------------------------------------------
   store.search#department / #category / #subcategory son las
   paginas que VTEX sirve cuando la categoria EXISTE en el
   catalogo. Usan el mismo layout con filtros y selector de
   vehiculo de las paginas generadas (bloques #rx-f de
   category-filters.jsonc), asi la vitrina se ve igual venga de
   donde venga. Las categorias marcadas "catalogo": true en
   catalogo/estructura-categorias-v2.json ya no generan pagina
   propia: las sirve VTEX con estos bloques.

   store.search (busqueda por texto) usa el MISMO layout #rx-cat.
   Antes se quedaba con el layout base del theme y eso dejaba la
   pagina de resultados sin Cris, sin breadcrumb y sin panel de
   filtros: el cliente buscaba, veia resultados y ahi se quedaba,
   sin poder refinar ni volver a buscar. El tyre-size-selector de
   ese layout trae showOn "llantas", asi que se oculta solo donde
   no aplica.
   ============================================================ */
{
  "store.search": {
    "blocks": [
      "search-result-layout#rx-cat"
    ],
    "props": {
      "context": {
        "skusFilter": "ALL",
        "simulationBehavior": "skip"
      }
    }
  },
  "store.search#brand": {
    "blocks": [
      "search-result-layout#rx-cat"
    ],
    "props": {
      "context": {
        "orderByField": "OrderByReleaseDateDESC",
        "hideUnavailableItems": true,
        "maxItemsPerPage": 10,
        "skusFilter": "ALL",
        "simulationBehavior": "skip"
      }
    }
  },
  "store.search#department": {
    "blocks": [
      "search-result-layout#rx-cat"
    ],
    "props": {
      "context": {
        "skusFilter": "FIRST_AVAILABLE",
        "simulationBehavior": "skip"
      }
    }
  },
  "store.search#category": {
    "blocks": [
      "search-result-layout#rx-cat"
    ],
    "props": {
      "context": {
        "skusFilter": "FIRST_AVAILABLE",
        "simulationBehavior": "skip"
      }
    }
  },
  "store.search#subcategory": {
    "blocks": [
      "search-result-layout#rx-cat"
    ],
    "props": {
      "context": {
        "skusFilter": "FIRST_AVAILABLE",
        "simulationBehavior": "skip"
      }
    }
  },
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  
  "breadcrumb": {
    "props": {
      "showOnMobile": true
    }
  },
  
  
  
  
  
  
  
  
  "search-result-layout#rx-cat": {
    "blocks": [
      "search-result-layout.desktop#rx-cat",
      "search-result-layout.mobile#rx-cat",
      "search-not-found-layout#rx"
    ]
  },
  "search-result-layout.desktop#rx-cat": {
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid",
      "blockClass": "rxF"
    },
    "children": [
      "flex-layout.row#rx-cat-head",
      "flex-layout.row#rx-size",
      "flex-layout.row#rx-f-body",
      "flex-layout.row#rx-abajo"
    ]
  },
  "search-result-layout.mobile#rx-cat": {
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid",
      "blockClass": "rxF"
    },
    "children": [
      "flex-layout.row#rx-cat-head",
      "flex-layout.row#rx-size",
      "flex-layout.row#rx-results-f",
      "flex-layout.row#rx-filterbar-m",
      "flex-layout.row#rx-abajo"
    ]
  },

  /* "Tambien te puede interesar": tres bloques debajo de los resultados,
     separados por cuanta certeza hay de que el producto le sirve. Cada uno
     se pinta solo si tiene contenido, asi que con el catalogo joven la
     mayoria de las veces no aparece nada y la pagina no miente. */
  "flex-layout.row#rx-abajo": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxAbajo"
    },
    "children": [
      "tambien-te-interesa#rx"
    ]
  },
  "tambien-te-interesa#rx": {
    "props": {
      "titulo": "También te puede interesar"
    }
  },
  "flex-layout.row#rx-cat-head": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxCatHead"
    },
    "children": [
      "flex-layout.col#rx-cat-head-inner"
    ]
  },
  "flex-layout.col#rx-cat-head-inner": {
    "props": {
      "blockClass": "rxCatHeadInner",
      "width": "100%"
    },
    "children": [
      "breadcrumb.search",
      "search-title.v2",
      "vehiculo-en-pagina#rx"
    ]
  },
  /* El header no dice que carro quedo guardado, solo lo marca con el
     icono lleno. El nombre sale aqui, junto a los resultados que ese
     vehiculo esta filtrando: sin esto alguien navega filtrado por el
     carro de otra persona y no se entera. */
  "vehiculo-en-pagina#rx": {
    "props": {
      "prefijo": "Para tu"
    }
  },
  "flex-layout.row#rx-size": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxSizeRow"
    },
    "children": [
      "tyre-size-selector#rx"
    ]
  },
  "tyre-size-selector#rx": {
    "props": {
      "showOn": "llantas"
    }
  }
}
