/* ============================================================
   HERO POR SECCION — slideshow independiente para /carros y /motos
   ------------------------------------------------------------
   3 slides por seccion. Cada seccion tiene su propio slider y
   sus propios slides, asi que se pueden editar por separado.
   El home NO lleva hero: ahi va el selector carros | motos.

   Diseno (referencias/home): tarjeta con esquinas redondeadas
   separada del borde, texto a la izquierda, CTA en pildora
   blanca, pildoras de confianza abajo a la izquierda, puntos al
   centro y flechas a la derecha sobre una linea fina.

   IMAGENES: los src son PLACEHOLDERS en SVG embebido que dicen
   "REEMPLAZAR". Para poner la real solo se cambia "src" en
   image#rx-<seccion>-slide-N-img. Tamano recomendado 1600x700.
   Encuadre: --rxFocus en el CSS.

   Para agregar un slide: duplica el bloque rx-<seccion>-slide-N
   y agregalo a children del slider de esa seccion.
   ============================================================ */
{
  "slider-layout#rx-hero-carros": {
    "props": {
      "blockClass": "rxHero",
      "itemsPerPage": {
        "desktop": 1,
        "tablet": 1,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": true,
      "usePagination": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "always",
      "autoplay": {
        "timeout": 6500,
        "stopOnHover": true
      }
    },
    "children": [
      "flex-layout.row#rx-carros-slide-1",
      "flex-layout.row#rx-carros-slide-2",
      "flex-layout.row#rx-carros-slide-3"
    ]
  },
  "flex-layout.row#rx-carros-slide-1": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxSlide"
    },
    "children": [
      "flex-layout.col#rx-carros-slide-1-media",
      "flex-layout.col#rx-carros-slide-1-content"
    ]
  },
  "flex-layout.col#rx-carros-slide-1-media": {
    "props": {
      "blockClass": "rxSlideMedia",
      "width": "100%"
    },
    "children": [
      "image#rx-carros-slide-1-img"
    ]
  },
  "image#rx-carros-slide-1-img": {
    "props": {
      "blockClass": "rxSlideImage",
      "src": "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1600 700'><rect width='1600' height='700' fill='%23010101'/><path d='M0 700 L1600 0 L1600 150 L330 700 Z' fill='%23FF371E' opacity='.16'/><text x='760' y='330' font-family='Montserrat,Helvetica,sans-serif' font-size='46' font-weight='800' fill='%23ffffff'>REEMPLAZAR</text><text x='760' y='390' font-family='Montserrat,Helvetica,sans-serif' font-size='28' fill='%23ffffff' opacity='.65'>carros-slide-1 / baterias / 1600x700</text></svg>",
      "alt": "Baterías para carro",
      "width": "1600",
      "height": "700"
    }
  },
  "flex-layout.col#rx-carros-slide-1-content": {
    "props": {
      "blockClass": "rxSlideContent",
      "width": "100%"
    },
    "children": [
      "rich-text#rx-carros-slide-1-eyebrow",
      "rich-text#rx-carros-slide-1-title",
      "rich-text#rx-carros-slide-1-body",
      "flex-layout.row#rx-carros-slide-1-ctas",
      "flex-layout.row#rx-carros-slide-1-trust"
    ]
  },
  "rich-text#rx-carros-slide-1-eyebrow": {
    "props": {
      "text": "Baterías",
      "blockClass": "rxEyebrow"
    }
  },
  "rich-text#rx-carros-slide-1-title": {
    "props": {
      "text": "Arranca hoy, arranca mañana",
      "blockClass": "rxTitle"
    }
  },
  "rich-text#rx-carros-slide-1-body": {
    "props": {
      "text": "Baterías para carro con respaldo de fábrica y asesoría para elegir la referencia correcta.",
      "blockClass": "rxBody"
    }
  },
  "flex-layout.row#rx-carros-slide-1-ctas": {
    "props": {
      "blockClass": "rxCtas",
      "preventHorizontalStretch": true
    },
    "children": [
      "rich-text#rx-carros-slide-1-cta1",
      "rich-text#rx-carros-slide-1-cta2"
    ]
  },
  "rich-text#rx-carros-slide-1-cta1": {
    "props": {
      "text": "[Ver baterías](/carros/electrico-y-electronico)",
      "blockClass": "rxCtaPrimary"
    }
  },
  "rich-text#rx-carros-slide-1-cta2": {
    "props": {
      "text": "[Motor](/carros/motor-y-transmision)",
      "blockClass": "rxCtaGhost"
    }
  },
  "flex-layout.row#rx-carros-slide-1-trust": {
    "props": {
