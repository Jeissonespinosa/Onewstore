/* ============================================================
   HERRAMIENTAS DE SECCION — buscador + "Busca por tu carro/moto"
   ------------------------------------------------------------
   Van justo debajo del hero en /carros y /motos.

   1. Buscador: search-bar de VTEX dentro de un sticky-layout.
      Al hacer scroll, cuando la barra llega al header se queda
      pegada debajo de el (verticalSpacing = alto del header) y
      al volver arriba regresa a su sitio.
   2. "Encuentra lo que tu carro/moto necesita": el vehicle-selector
      en disposicion "hero" (titulo, subtitulo, selects centrados,
      boton en pildora) con la categoria base de la seccion
      (carros = categoria "Carros" del catalogo; motos = "Motos",
      que debe crearse). Debajo, un loop infinito con las marcas
      en gris difuminado en los bordes (referencias/header).
      Las marcas van como texto; para usar logos, cambia cada
      {"name": "..."} por {"name": "...", "image": "<url png>"}
      (se muestran en escala de grises automaticamente).
   ============================================================ */
{
  "flex-layout.row#rx-tools-search": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxToolsSearch"
    },
    "children": [
      "sticky-layout#rx-search"
    ]
  },
  "sticky-layout#rx-search": {
    "props": {
      "position": "top",
      "verticalSpacing": 78,
      "blockClass": "rxSearch"
    },
    "children": [
      "flex-layout.row#rx-search-inner"
    ]
  },
  "flex-layout.row#rx-search-inner": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxSearchInner"
    },
    "children": [
      "search-bar#rx"
    ]
  },
  "search-bar#rx": {
    "props": {
      "blockClass": "rx",
      "placeholder": "¿Qué estás buscando?",
      "displayMode": "search-button",
      "submitOnIconClick": true,
      "autocompleteAlignment": "left",
      "openAutocompleteOnFocus": false
    }
  },
  "flex-layout.row#rx-tools-vehicle-carros": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxToolsVehicle"
    },
    "children": [
      "vehicle-selector#rx-home-carros"
    ]
  },
  "vehicle-selector#rx-home-carros": {
    "props": {
      "layout": "hero",
      "title": "Encuentra lo que tu carro necesita",
      "subtitle": "Elige marca, modelo y año y te mostramos solo los repuestos que le sirven.",
      "buttonLabel": "Ver productos",
      "query": "carros",
      "map": "c",
      "vehicle": "carros",
      "brands": [
        {
          "name": "Chevrolet"
        },
        {
          "name": "Renault"
        },
