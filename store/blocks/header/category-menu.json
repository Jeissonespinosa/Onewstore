{
  "vtex.menu@2.x:menu#category-menu": {
    "props": {
      "experimentalOptimizeRendering": true
    },
    "children": [
      "menu-item#nav-product-info",
      "menu-item#nav-where-buy",
      "menu-item#nav-contact"
    ]
  },
  "menu-item#nav-product-info": {
    "props": {
      "id": "menu-item-nav-product-info",
      "type": "custom",
      "iconId": null,
      "highlight": false,
      "itemProps": {
        "type": "internal",
        "href": "/faq",
        "noFollow": false,
        "tagTitle": "Información de productos",
        "text": "Información de productos"
      }
    }
  },
  "menu-item#nav-where-buy": {
    "props": {
      "id": "menu-item-nav-where-buy",
      "type": "custom",
      "iconId": null,
      "highlight": false,
      "itemProps": {
        "type": "internal",
        "href": "/about-us",
        "noFollow": false,
        "tagTitle": "¿Dónde comprar?",
        "text": "¿Dónde comprar?"
      }
    }
  },
  "menu-item#nav-contact": {
    "props": {
      "id": "menu-item-nav-contact",
      "type": "custom",
      "iconId": null,
      "highlight": false,
      "itemProps": {
        "type": "internal",
        "href": "/contact-us",
        "noFollow": false,
        "tagTitle": "Contáctanos",
        "text": "Contáctanos"
      }
    }
  }
}
