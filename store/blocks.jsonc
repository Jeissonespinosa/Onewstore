/* Blocks can be defined both on the store/blocks.json file, and in any number of json
 * files inside the store/blocks directory, with any arbitrary directory structure.
 *
 * Additionally, all blocks files can support comments, such as this one, if given the
 * .jsonc file extension.
 *
 * The store/blocks.json file is intended for backwards compatibility, for miscellaneous
 * blocks, or if the app is simple enough that it doesn't warrant splitting the file.
 */
{
  "store.orderplaced": {
    "blocks": ["order-placed"]
  },

  "store.account": {
    "blocks": ["my-account"],
    "parent": {
      "challenge": "challenge.profile"
    }
  },

  "store.login": {
    "blocks": ["login-content#default"]
  },

  "login-content#default": {
    "props": {
      "isInitialScreenOptionOnly": false,
      "defaultOption": 1,
      "showPasswordVerificationIntoTooltip": true
    }
  },

  "store.product-review-form": {
    "blocks": ["product-review-form"]
  },

  /* La pagina de "no existe". Decia "**PAGE NOT FOUND**", en ingles y sin
     una sola salida: el cliente que llegaba por un enlace viejo se quedaba
     ahi. Ahora dice que paso y por donde seguir. */
  "store.not-found": {
    "blocks": ["flex-layout.row#rx-404"]
  },

  "store.not-found#product": {
    "blocks": ["flex-layout.row#rx-404"]
  },

  "store.not-found#search": {
    "blocks": ["flex-layout.row#rx-404"]
  },

  "flex-layout.row#rx-404": {
    "props": {
      "blockClass": "rx404",
      "horizontalAlign": "center",
      "paddingTop": 8,
      "paddingBottom": 8
    },
    "children": ["flex-layout.col#rx-404"]
  },

  "flex-layout.col#rx-404": {
    "props": {
      "blockClass": "rx404Col",
      "horizontalAlign": "center"
    },
    "children": ["rich-text#not-found", "rich-text#rx-404-salidas"]
  },

  "rich-text#not-found": {
    "props": {
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "text": "## Esta página no existe\n\nPuede que el enlace esté viejo o que la escribieras distinto. Busca el repuesto arriba, o entra por tu vehículo.",
      "blockClass": "rx404Texto"
    }
  },

  "rich-text#rx-404-salidas": {
    "props": {
      "textAlignment": "CENTER",
      "textPosition": "CENTER",
      "text": "[Repuestos para carro](/carros) · [Repuestos para moto](/motos) · [Herramienta de taller](/herramientas)",
      "blockClass": "rx404Salidas"
    }
  }
}
