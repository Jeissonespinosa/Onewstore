  "flex-layout.row#category-hero-baterias": {
    "props": {
      "fullWidth": true,
      "blockClass": "categoryHeroRow"
    },
    "children": ["flex-layout.col#category-hero-content-baterias"]
  },
  "flex-layout.col#category-hero-content-baterias": {
    "props": {
      "blockClass": "categoryHeroCol"
    },
    "children": [
      "flex-layout.col#category-hero-slot-image-baterias",
      "flex-layout.col#category-hero-slot-title-baterias",
      "flex-layout.col#category-hero-slot-description-baterias",
      "flex-layout.col#category-hero-slot-cta-baterias"
    ]
  },
  "flex-layout.col#category-hero-slot-image-baterias": {
    "props": {
      "blockClass": "categoryHeroSlotImage",
      "width": "100%"
    },
    "children": ["image#category-hero-image-baterias"]
  },
  "flex-layout.col#category-hero-slot-title-baterias": {
    "props": {
      "blockClass": "categoryHeroSlotTitle",
      "width": "100%"
    },
    "children": ["rich-text#category-hero-title-baterias"]
  },
  "flex-layout.col#category-hero-slot-description-baterias": {
    "props": {
      "blockClass": "categoryHeroSlotDescription",
      "width": "100%"
    },
    "children": ["rich-text#category-hero-description-baterias"]
  },
  "flex-layout.col#category-hero-slot-cta-baterias": {
    "props": {
      "blockClass": "categoryHeroSlotCta",
      "width": "100%"
    },
    "children": ["rich-text#category-hero-cta-baterias"]
  },
  "image#category-hero-image-baterias": {
    "props": {
      "blockClass": "categoryHeroImage",
      "src": "https://coexitoestaticas.vtexassets.com/assets/vtex.file-manager-graphql/images/0c95a74e-d4ba-427b-aab7-71d21229a958___0375867a055bd6ecd6a15bec5bbeff10.png",
      "alt": "Baterias"
    }
  },
  "rich-text#category-hero-title-baterias": {
    "props": {
      "text": "# Baterías",
      "blockClass": "categoryHeroTitle"
    }
  },
  "rich-text#category-hero-description-baterias": {
    "props": {
      "text": "Aqui ira el texto descriptivo de esta categoria para actualizarlo en el futuro.",
      "blockClass": "categoryHeroDescription"
    }
  },
  "rich-text#category-hero-cta-baterias": {
    "props": {
      "text": "[Quiero conocer más](/contact-us)",
      "blockClass": "categoryHeroButton"
    }
  },

