{
  "footer": {
    "blocks": ["footer-layout.desktop", "footer-layout.mobile"]
  },

  "footer-layout.desktop": {
    "children": [
      "flex-layout.row#repuestox-footer-socials",
      "flex-layout.row#footer-payments",
      "flex-layout.row#footer-credits"
    ]
  },

  "footer-layout.mobile": {
    "children": [
      "flex-layout.row#repuestox-footer-socials",
      "flex-layout.row#footer-payments",
      "flex-layout.row#footer-credits"
    ]
  },

  "flex-layout.row#repuestox-footer-socials": {
    "props": {
      "blockClass": "repuestoxSocials",
      "paddingTop": 4,
      "paddingBottom": 2,
      "horizontalAlign": "center",
      "preventHorizontalStretch": true
    },
    "children": [
      "image#repuestox-social-facebook",
      "image#repuestox-social-instagram",
      "image#repuestox-social-tiktok"
    ]
  },

  "image#repuestox-social-facebook": {
    "props": {
      "blockClass": "repuestoxSocialIcon",
      "src": "https://cdn.simpleicons.org/facebook/1f2937",
      "alt": "Facebook",
      "link": {
        "url": "https://www.facebook.com/",
        "newTab": true,
        "attributeNofollow": true
      }
    }
  },
  "image#repuestox-social-instagram": {
    "props": {
      "blockClass": "repuestoxSocialIcon",
      "src": "https://cdn.simpleicons.org/instagram/1f2937",
      "alt": "Instagram",
      "link": {
        "url": "https://www.instagram.com/",
        "newTab": true,
        "attributeNofollow": true
      }
    }
  },
  "image#repuestox-social-tiktok": {
    "props": {
      "blockClass": "repuestoxSocialIcon",
      "src": "https://cdn.simpleicons.org/tiktok/1f2937",
      "alt": "TikTok",
      "link": {
        "url": "https://www.tiktok.com/",
        "newTab": true,
        "attributeNofollow": true
      }
    }
  },

  "flex-layout.row#footer-payments": {
    "children": ["accepted-payment-methods"],
    "props": {
      "blockClass": "payment-methods",
      "paddingTop": 2,
      "paddingBottom": 3,
      "horizontalAlign": "center"
    }
  },
  "accepted-payment-methods": {
    "props": {
      "paymentMethods": ["MasterCard", "Visa", "Diners Club"]
    }
  },

  "flex-layout.row#footer-credits": {
    "children": ["rich-text#footer"],
    "props": {
      "blockClass": "credits",
      "paddingBottom": 4
    }
  },
  "rich-text#footer": {
    "props": {
      "text": "© Repuestox · Todos los derechos reservados",
      "textAlignment": "CENTER",
      "blockClass": "footer"
    }
  }
}
