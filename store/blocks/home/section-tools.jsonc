  "flex-layout.row#rx-tools-vehicle-motos": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxToolsVehicle"
    },
    "children": [
      "vehicle-selector#rx-home-motos"
    ]
  },
  "vehicle-selector#rx-home-motos": {
