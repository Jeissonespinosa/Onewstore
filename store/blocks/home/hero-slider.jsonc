      "rich-text#rx-carros-slide-1-trust-1",
      "rich-text#rx-carros-slide-1-trust-2"
    ]
  },
  "rich-text#rx-carros-slide-1-trust-1": {
    "props": {
      "text": "Envíos a toda Colombia",
      "blockClass": "rxTrustPill"
    }
  },
  "rich-text#rx-carros-slide-1-trust-2": {
