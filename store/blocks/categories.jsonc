{
  "store.custom#categoria-baterias": {
    "blocks": [
      "flex-layout.row#category-hero-baterias",
      "rich-text#category-offer-title",
      "rich-text#category-offer-subtitle"
    ]
  },
  "store.custom#categoria-lubricantes": {
    "blocks": [
      "flex-layout.row#category-hero-lubricantes",
      "rich-text#category-offer-title",
      "rich-text#category-offer-subtitle"
    ]
  },
