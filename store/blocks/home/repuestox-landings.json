{
  "store.custom#landing-carros": {
    "blocks": [
      "flex-layout.row#carros-hero",
      "flex-layout.row#carros-products-anchor",
      "search-result-layout.customQuery#carros",
      "flex-layout.row#carros-cta-banner",
      "rich-text#repuestox-section-brands-landing-carros",
      "flex-layout.row#repuestox-brands-static-landing-carros"
    ]
  },
  "store.custom#landing-motos": {
    "blocks": [
      "rich-text#repuestox-section-products-landing-motos",
      "flex-layout.row#repuestox-categories-grid-landing-motos",
      "rich-text#repuestox-section-brands-landing-motos",
      "flex-layout.row#repuestox-brands-static-landing-motos"
    ]
  },

  "flex-layout.row#carros-hero": {
    "props": {
      "fullWidth": true,
      "blockClass": "carrosHero"
    },
    "children": ["flex-layout.col#carros-hero-content"]
  },
  "flex-layout.col#carros-hero-content": {
    "props": {
      "blockClass": "carrosHeroContent",
      "verticalAlign": "middle",
      "horizontalAlign": "center",
      "width": "100%"
    },
    "children": [
      "rich-text#carros-hero-h1",
      "rich-text#carros-hero-subheading",
      "rich-text#carros-hero-cta"
    ]
  },
  "rich-text#carros-hero-h1": {
    "props": {
      "text": "# Repuestos de Alta Calidad para Tu Carro",
      "textAlignment": "CENTER",
      "blockClass": "carrosHeroH1"
    }
  },
  "rich-text#carros-hero-subheading": {
    "props": {
      "text": "Encuentra los mejores repuestos, lubricantes, baterías y accesorios para mantener tu vehículo en perfecto estado.",
      "textAlignment": "CENTER",
      "blockClass": "carrosHeroSubheading"
    }
  },
  "rich-text#carros-hero-cta": {
    "props": {
      "text": "[**Ver productos disponibles ↓**](#carros-produtos)",
      "textAlignment": "CENTER",
      "blockClass": "carrosHeroCta"
    }
  },

  "flex-layout.row#carros-products-anchor": {
    "children": ["rich-text#carros-products-title"],
    "props": {
      "fullWidth": true,
      "htmlId": "carros-produtos",
      "blockClass": "carrosProductosSection"
    }
  },

  "rich-text#carros-products-title": {
    "props": {
      "text": "## Productos disponibles para carros",
      "textAlignment": "CENTER",
      "blockClass": "repuestoxSectionHeading"
    }
  },

  "search-result-layout.customQuery#carros": {
    "props": {
      "querySchema": {
        "query": "carros",
        "map": "c",
        "orderByField": "OrderByScoreDESC",
        "hideUnavailableItems": false,
        "skusFilter": "ALL_AVAILABLE",
        "maxItemsPerPage": 12
      }
    },
    "blocks": [
      "search-result-layout.desktop#carros",
      "search-result-layout.mobile#carros",
      "search-not-found-layout#carros"
    ]
  },

  "search-result-layout.desktop#carros": {
    "children": [
      "flex-layout.row#carros-products"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid"
    }
  },

  "search-result-layout.mobile#carros": {
    "children": [
      "flex-layout.row#carros-products"
    ],
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid"
    }
  },

  "search-not-found-layout#carros": {
    "children": ["rich-text#carros-no-products"]
  },

  "rich-text#carros-no-products": {
    "props": {
      "text": "No hay productos disponibles en este momento.",
      "textAlignment": "CENTER",
      "blockClass": "repuestoxSectionHeading"
    }
  },

  "flex-layout.row#carros-products": {
    "children": ["search-content#carros"],
    "props": {
      "fullWidth": true
    }
  },

  "search-content#carros": {
    "blocks": ["gallery#carros", "not-found"]
  },

  "gallery#carros": {
    "props": {
      "layouts": [
        {
          "name": "grid",
          "component": "GridSummary",
          "itemsPerRow": {
            "(min-width:1300px)": 4,
            "desktop": 3,
            "tablet": 2,
            "phone": 2
          }
        }
      ],
      "GridSummary": "product-summary.shelf"
    }
  },

  "rich-text#repuestox-section-products-landing-motos": {
