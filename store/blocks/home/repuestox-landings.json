{
  "store.custom#landing-carros": {
    "blocks": [
      "slider-layout#rx-hero-carros",
      "flex-layout.row#rx-tools-search",
      "flex-layout.row#rx-tools-vehicle-carros",
      "flex-layout.row#rx-lineas-section-carros",
      "flex-layout.row#rx-productos-carros",
      "flex-layout.row#carros-cta-banner",
      "rich-text#repuestox-section-brands-landing-carros",
      "flex-layout.row#repuestox-brands-static-landing-carros"
    ]
  },
  "store.custom#landing-motos": {
    "blocks": [
      "slider-layout#rx-hero-motos",
      "flex-layout.row#rx-tools-search",
      "flex-layout.row#rx-tools-vehicle-motos",
      "flex-layout.row#rx-lineas-section-motos",
      "rich-text#repuestox-section-brands-landing-motos",
      "flex-layout.row#repuestox-brands-static-landing-motos"
    ]
  },
  "flex-layout.row#carros-cta-banner": {
    "props": {
      "fullWidth": true,
      "blockClass": "carrosCtaBanner"
    },
    "children": [
      "flex-layout.col#carros-cta-banner-content"
    ]
  },
  "flex-layout.col#carros-cta-banner-content": {
    "props": {
      "blockClass": "carrosCtaBannerContent",
      "verticalAlign": "middle",
      "horizontalAlign": "center",
      "width": "100%"
    },
    "children": [
      "rich-text#carros-cta-banner-title",
      "rich-text#carros-cta-banner-button"
    ]
  },
  "rich-text#carros-cta-banner-title": {
    "props": {
      "text": "## ¿No encuentras el repuesto que buscas?",
      "textAlignment": "CENTER",
      "blockClass": "carrosCtaBannerTitle"
    }
  },
  "rich-text#carros-cta-banner-button": {
    "props": {
      "text": "[Escríbenos y lo conseguimos](/contact-us)",
      "textAlignment": "CENTER",
      "blockClass": "carrosCtaBannerButton"
    }
  },
  "rich-text#repuestox-section-brands-landing-carros": {
    "props": {
      "text": "## Contamos con marcas lideres en el mercado",
      "textAlignment": "CENTER",
      "blockClass": "repuestoxSectionHeading"
    }
  },
  "rich-text#repuestox-section-brands-landing-motos": {
    "props": {
      "text": "## Marcas para tu linea de motos",
      "textAlignment": "CENTER",
      "blockClass": "repuestoxSectionHeading"
    }
  },
  "flex-layout.row#repuestox-brands-static-landing-carros": {
    "props": {
      "fullWidth": true,
      "preventHorizontalStretch": true,
      "blockClass": "repuestoxBrandsStaticRow"
    },
    "children": [
      "flex-layout.col#repuestox-brand-1-landing-carros",
      "flex-layout.col#repuestox-brand-2-landing-carros",
      "flex-layout.col#repuestox-brand-3-landing-carros",
      "flex-layout.col#repuestox-brand-4-landing-carros",
      "flex-layout.col#repuestox-brand-5-landing-carros"
    ]
  },
  "flex-layout.row#repuestox-brands-static-landing-motos": {
    "props": {
      "fullWidth": true,
      "preventHorizontalStretch": true,
      "blockClass": "repuestoxBrandsStaticRow"
    },
    "children": [
      "flex-layout.col#repuestox-brand-1-landing-motos",
      "flex-layout.col#repuestox-brand-2-landing-motos",
      "flex-layout.col#repuestox-brand-3-landing-motos",
      "flex-layout.col#repuestox-brand-4-landing-motos",
      "flex-layout.col#repuestox-brand-5-landing-motos"
