{
  "header": {
    "blocks": ["header-layout.desktop", "header-layout.mobile"]
  },
  "header.full": {
    "blocks": ["header-layout.desktop", "header-layout.mobile"]
  },
  "header-layout.desktop": {
    "children": [
      "flex-layout.row#1-desktop",
      "sticky-layout#4-desktop"
    ]
  },

  "flex-layout.row#1-desktop": {
    "children": ["telemarketing"],
    "props": {
      "fullWidth": true
    }
  },

  "flex-layout.col#spacer": {
    "props": {
      "width": "grow"
    }
  },
  "sticky-layout#4-desktop": {
    "props": {
      "blockClass": "sticky-header"
    },
    "children": ["flex-layout.row#4-desktop"]
  },
  "flex-layout.row#4-desktop": {
    "props": {
      "blockClass": "main-header",
      "horizontalAlign": "center",
      "verticalAlign": "center",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true,
      "fullWidth": true
    },
    "children": [
      "flex-layout.col#logo-desktop",
      "flex-layout.col#spacer",
      "flex-layout.col#category-menu",
      "flex-layout.row#header-actions"
    ]
  },
  "flex-layout.row#header-actions": {
    "props": {
      "verticalAlign": "middle",
      "preventVerticalStretch": true,
      "preventHorizontalStretch": true,
      "blockClass": "headerActions"
    },
    "children": ["login", "minicart.v2"]
  },
  "login": {
    "props": {
      "iconLabel": "ingreso de clientes",
      "showIconProfile": false
    }
  },
  "flex-layout.col#logo-desktop": {
    "props": {
      "verticalAlign": "middle"
    },
    "children": ["logo#desktop"]
  },
  "flex-layout.col#category-menu": {
    "props": {
      "verticalAlign": "middle",
      "blockClass": "headerNavLinks"
    },
    "children": ["vtex.menu@2.x:menu#category-menu"]
  },
  "logo#desktop": {
    "props": {
      "title": "Repuestox",
      "href": "/",
      "url": "https://onewstore.vtexassets.com/assets/vtex.file-manager-graphql/images/772c8205-47cf-4795-ae5d-40aced62274f___c4c0ef3890ef1285c76b15521a8a13ab.png",
      "width": "180",
      "height": "54"
    }
  },
  "header-layout.mobile": {
    "children": ["sticky-layout#1-mobile"]
  },
  "sticky-layout#1-mobile": {
    "children": ["flex-layout.row#1-mobile"]
  },
  "flex-layout.row#1-mobile": {
    "children": [
      "flex-layout.col#drawer-mobile",
      "logo#mobile",
      "flex-layout.col#spacer",
      "flex-layout.col#header-actions-mobile"
    ],
    "props": {
      "blockClass": "main-header-mobile",
      "preventHorizontalStretch": true,
      "preserveLayoutOnMobile": true,
      "fullWidth": true
    }
  },
  "flex-layout.col#drawer-mobile": {
    "props": {
      "verticalAlign": "middle",
      "blockClass": "headerDrawerMobile"
    },
    "children": ["drawer"]
  },
  "flex-layout.col#header-actions-mobile": {
    "props": {
      "verticalAlign": "middle",
      "blockClass": "headerActionsMobile"
    },
    "children": ["login", "minicart.v2"]
  },
  "drawer": {
    "children": ["menu#drawer"]
  },

  "menu#drawer": {
    "children": [
      "menu-item#nav-product-info",
      "menu-item#nav-where-buy",
      "menu-item#nav-contact"
    ],
    "props": {
      "orientation": "vertical"
    }
  },

  "logo#mobile": {
    "props": {
      "title": "Repuestox",
      "href": "/",
      "url": "https://onewstore.vtexassets.com/assets/vtex.file-manager-graphql/images/772c8205-47cf-4795-ae5d-40aced62274f___c4c0ef3890ef1285c76b15521a8a13ab.png",
      "width": "130",
      "height": "40"
    }
  }
}
