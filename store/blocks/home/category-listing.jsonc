/* ============================================================
   LISTADO — solo paginas de tipo de producto (sin hijos)
   ------------------------------------------------------------
   Debajo del banner va la barra "Ordenar por:" y el listado con la
   misma tarjeta del home, con el layout de filtros y selector de
   vehiculo (#rx-f, en category-filters.jsonc). Las macros y
   subcategorias no listan productos: solo muestran su cuadricula.
   El layout simple (#rx) queda disponible por si alguna pagina lo
   necesita.

   Es un search-result real: cuando haya productos aparecen solos.
   Mientras tanto el not-found nativo se muestra como panel gris
   ("Pronto tendremos productos en esta categoria").

   IMPORTANTE — la consulta de cada pagina es un PLACEHOLDER que
   apunta a una coleccion inexistente (id 999999) para que el
   listado salga vacio y no muestre productos de otras lineas.
   Los campos del querySchema son queryField / mapField (con
   query / map VTEX los ignora y lista todo el catalogo).
   Cuando las categorias existan en el catalogo, regenera con
     python3 scripts/gen-categorias.py --real
   y cada pagina consulta su ruta ("carros/frenos/pastillas-de-freno",
   mapField "c,c,c").

   Opciones de orden: las nativas de VTEX. Para ocultar alguna,
   agregala a hiddenOptions en order-by.v2#rx (p. ej.
   "OrderByScoreDESC").

   Modo actual: placeholder (999999)

   GENERADO por scripts/gen-categorias.py — no editar a mano;
   cambia catalogo/estructura-categorias-v2.* y vuelve a correrlo.
   ============================================================ */
{
  "search-result-layout.desktop#rx": {
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid",
      "blockClass": "rx"
    },
    "children": [
      "flex-layout.row#rx-filterbar",
      "flex-layout.row#rx-results"
    ]
  },
  "search-result-layout.mobile#rx": {
    "props": {
      "pagination": "show-more",
      "preventRouteChange": true,
      "defaultGalleryLayout": "grid",
      "blockClass": "rx"
    },
    "children": [
      "flex-layout.row#rx-filterbar",
      "flex-layout.row#rx-results"
    ]
  },
  "flex-layout.row#rx-filterbar": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxFilterbar",
      "preventHorizontalStretch": true,
      "preserveLayoutOnMobile": true
    },
    "children": [
      "rich-text#rx-orderby-label",
      "order-by.v2#rx"
    ]
  },
  "rich-text#rx-orderby-label": {
    "props": {
      "text": "Ordenar por:",
      "blockClass": "rxOrderByLabel"
    }
  },
  "order-by.v2#rx": {
    "props": {
      "blockClass": "rx",
      "hiddenOptions": []
    }
  },
  "flex-layout.row#rx-results": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxResults"
    },
    "children": [
      "search-content#rx"
    ]
  },
  "search-content#rx": {
    "blocks": [
      "gallery#rx",
      "not-found#rx"
    ]
  },
  "gallery#rx": {
    "props": {
      "layouts": [
        {
          "name": "grid",
          "component": "GridSummary",
          "itemsPerRow": {
            "(min-width:1300px)": 4,
            "desktop": 4,
            "tablet": 3,
            "phone": 2
          }
        }
      ],
      "GridSummary": "product-summary.shelf#rx",
      "blockClass": "rx"
    }
  },
  "not-found#rx": {
    "props": {
      "blockClass": "rx"
    }
  },
  "search-not-found-layout#rx": {
    "children": [
      "flex-layout.row#rx-filterbar",
      "flex-layout.row#rx-empty"
    ]
  },
  "flex-layout.row#rx-empty": {
    "props": {
      "fullWidth": true,
      "blockClass": "rxEmpty"
    },
    "children": [
      "rich-text#rx-empty-text"
    ]
  },
  "rich-text#rx-empty-text": {
    "props": {
      "text": "Pronto tendremos productos en esta categoría.",
      "blockClass": "rxEmptyText"
    }
  },
  "search-result-layout.customQuery#rx-carros-llantas-y-rines-rines-rines-de-acero": {
    "props": {
      "querySchema": {
        "queryField": "999999",
        "mapField": "productClusterIds",
        "orderByField": "OrderByNameASC",
        "hideUnavailableItems": true,
        "skusFilter": "FIRST_AVAILABLE",
        "maxItemsPerPage": 24
      }
    },
    "blocks": [
      "search-result-layout.desktop#rx-f",
      "search-result-layout.mobile#rx-f",
      "search-not-found-layout#rx"
    ]
  },
